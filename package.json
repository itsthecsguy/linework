{
  "name": "@itsthecsguy/linework",
  "version": "0.3.0",
  "description": "Software diagrams an AI can write and a person can edit. YAML spec in, .drawio.svg out, editable in draw.io.",
  "keywords": [
    "diagram",
    "drawio",
    "draw.io",
    "architecture",
    "flowchart",
    "sequence-diagram",
    "er-diagram",
    "mcp",
    "agent-skill",
    "ai",
    "svg",
    "mermaid"
  ],
  "author": "Nick Salerni",
  "license": "MIT",
  "type": "module",
  "bin": {
    "linework": "dist/cli.js",
    "aiviz": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "assets": "node scripts/copy-drawio-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs",
    "fonts": "node scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@xmldom/xmldom": "^0.9.12",
    "elkjs": "^0.12.1",
    "playwright-core": "^1.64.1",
    "subset-font": "^2.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsthecsguy/linework.git"
  },
  "homepage": "https://github.com/itsthecsguy/linework#readme",
  "publishConfig": {
    "access": "public"
  }
}
